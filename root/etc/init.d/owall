#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

CONFIG="owall"
PROG="/usr/share/owall/app.sh"
LOG_FILE="/var/log/owall.log"

start_service() {
	local enabled
	config_load "$CONFIG"
	config_get enabled global enabled "0"
	[ "$enabled" = "1" ] || {
		"$PROG" stop_firewall >/dev/null 2>&1
		return 0
	}

	mkdir -p /var/log /var/etc
	echo "[$(date '+%F %T')] Starting Owall service..." > "$LOG_FILE"

	# Synchronously parse nodes and generate Xray config BEFORE launching procd & firewall
	"$PROG" prepare >> "$LOG_FILE" 2>&1 || return 1

	procd_open_instance "$CONFIG"
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	"$PROG" start_firewall >> "$LOG_FILE" 2>&1
}

stop_service() {
	"$PROG" stop_firewall >/dev/null 2>&1
	"$PROG" kill_all >/dev/null 2>&1
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
