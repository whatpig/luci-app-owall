#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

CONFIG="owall"
PROG="/usr/share/owall/app.sh"

start_service() {
	local enabled
	config_load "$CONFIG"
	config_get enabled global enabled "0"
	[ "$enabled" = "1" ] || return 0

	procd_open_instance "$CONFIG"
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Run firewall and routing setup
	"$PROG" start_firewall
}

stop_service() {
	"$PROG" stop_firewall
	"$PROG" kill_all
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
