{
	"luci-app-owall": {
		"description": "Grant UCI and system access for luci-app-owall",
		"read": {
			"uci": [ "owall" ],
			"file": {
				"/var/log/owall.log": [ "read" ],
				"/tmp/owall_status.json": [ "read" ],
				"/tmp/owall_upgrade.log": [ "read" ],
				"/tmp/owall_upgrade_state.json": [ "read" ],
				"/tmp/owall_upgrade_versions.json": [ "read" ]
			}
		},
		"write": {
			"uci": [ "owall" ]
		}
	}
}
